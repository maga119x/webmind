{
  "name": "webmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js && node scripts/build-scripts.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:test": "node --test tests/docs-check.test.mjs",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:e2e:drive": "npm run build && playwright test --config playwright.drive.config.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.5",
    "@xmldom/xmldom": "^0.8.11",
    "better-auth": "^1.3.0",
    "better-sqlite3": "^12.0.0",
    "dompurify": "^3.2.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.2"
  }
}
