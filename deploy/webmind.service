[Unit]
Description=WebMind private Google Drive mind map editor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=webmind
Group=webmind
WorkingDirectory=/srv/webmind/current
EnvironmentFile=/etc/webmind/webmind.env
ExecStart=/usr/bin/node --max-old-space-size=192 dist/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
StateDirectory=webmind
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/webmind
MemoryHigh=320M
MemoryMax=384M
CPUQuota=50%
TasksMax=96
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webmind
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
