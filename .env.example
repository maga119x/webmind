NODE_ENV=development
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:5173
AUTH_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=./data
EMAIL_AUTH_ENABLED=true
# In development only, empty SMTP_HOST writes mail to data/mailbox.jsonl.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WebMind <noreply@example.com>

# Google sign-in and the separate Drive consent flow use this web OAuth client.
# Keep AUTH_SECRET stable: changing it invalidates encrypted OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser-visible Picker API key (restrict by HTTP referrer and API).
GOOGLE_PICKER_API_KEY=
# Numeric Google Cloud project number, not the project ID.
GOOGLE_PROJECT_NUMBER=
